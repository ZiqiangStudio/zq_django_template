#############
# Django (本地开发默认生效，生产环境由部署系统注入)
#############
DJANGO_ENV=development
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-change-in-production
SERVER_URL=http://localhost:8000
LOG_LEVEL=INFO
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
GUNICORN_WORKERS=2

#############
# 数据库与缓存 (本地默认使用 SQLite 与内存缓存)
#############
# 若在本地连接自己的 MySQL 或 Redis，取消注释并修改即可：
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/zq_project
# CACHE_URL=redis://127.0.0.1:6379/0

#############
# 自强 CAS 统一认证 (对接 zq_auth)
#############
ZQAUTH_APPID=your-zqauth-appid
ZQAUTH_SECRET=your-zqauth-secret
